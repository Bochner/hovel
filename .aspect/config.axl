load("@aspect//bazel.axl", "BazelTrait")
load(".aspect/metadata.axl", "metadata_flags")

def _selected_bazel_flags(ctx: ConfigContext) -> list[str]:
    explicit = ctx.std.env.var("HOVEL_BAZEL_ARGS")
    if explicit:
        return explicit.split()

    if ctx.std.env.var("CI") or ctx.std.env.var("GITHUB_ACTIONS"):
        return ["--config=ci"]

    selection = ctx.std.env.aspect_root_dir().rstrip("/") + "/.hovel-bazel-config"
    if not ctx.std.fs.exists(selection):
        return []

    mode = ctx.std.fs.read_to_string(selection).strip()
    configs = {
        "": [],
        "local": ["--config=local-cache"],
        "nativelink": ["--config=nativelink"],
        "nativelink-minimal": ["--config=nativelink-minimal"],
        "buildbuddy": ["--config=buildbuddy"],
    }
    if mode not in configs:
        fail("unknown Bazel config mode in .hovel-bazel-config: " + mode)
    return configs[mode]

def config(ctx: ConfigContext):
    # Bazel requires sandbox_writable_path to exist before any action starts.
    ctx.std.fs.create_dir_all("/tmp/hovel-zig-cache")

    # The root workspace also contains a separate core workspace. Recursive
    # discovery would load core's packages with root-relative labels.
    ctx.tasks["build"].args.targets = ["@hovel_core//:build"]
    ctx.tasks["test"].args.targets = ["@hovel_core//:test"]

    flags = _selected_bazel_flags(ctx)
    provenance = metadata_flags(ctx)
    bep_dir = ctx.std.env.var("HOVEL_BEP_DIR")
    if bep_dir:
        ctx.std.fs.create_dir_all(bep_dir)
        provenance.append("--build_event_json_file=" + bep_dir + "/" + str(ctx.std.process.id()) + ".json")
    startup = ctx.std.env.var("HOVEL_BAZEL_STARTUP_ARGS")
    startup_flags = startup.split() if startup else []

    # Preserve the selected backend when a workflow adds --bazel-flag
    # (for example coverage or Picblobs flags). CLI flags remain overrides.
    # Checkout provenance wins over CI-event defaults (manual releases may
    # check out a different revision). Command flags still override backend flags.
    ctx.traits[BazelTrait].flags = lambda command_flags: flags + command_flags + provenance
    ctx.traits[BazelTrait].extra_startup_flags = startup_flags

    for task_name in ["build", "test"]:
        ctx.tasks[task_name].args.repro_flavors = ["aspect"]

    ctx.tasks["run"].args.run_in = "bazel-root"
